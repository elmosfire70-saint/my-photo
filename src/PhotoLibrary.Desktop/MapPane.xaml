<!-- 선택 사진의 GPS 핀과 출처가 표시된 소형 지도를 상단 영역에 배치합니다. -->
<UserControl x:Class="PhotoLibrary.Desktop.MapPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border BorderBrush="#CDD8E3" BorderThickness="1" CornerRadius="5" Background="White" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="LocationLabel" Text="사진 위치 · 사진을 선택하세요." Margin="6,3" FontSize="11" TextTrimming="CharacterEllipsis"/>
   <Grid Grid.Row="1" ClipToBounds="True" Background="#E5ECE7">
    <Canvas x:Name="Surface" Background="Transparent" ClipToBounds="True" SizeChanged="Surface_SizeChanged"
            MouseWheel="Surface_MouseWheel" MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp">
     <Canvas x:Name="Layer"/>
    </Canvas>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
     <Button x:Name="ZoomIn" Content="+" Padding="5,0" Margin="0,0,0,2" Click="ZoomIn_Click" AutomationProperties.Name="지도 확대"/>
     <Button x:Name="ZoomOut" Content="−" Padding="5,0" Margin="0" Click="ZoomOut_Click" AutomationProperties.Name="지도 축소"/>
    </StackPanel>
    <TextBlock x:Name="TileStatus" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#EFFFFFFF" FontSize="10" Margin="3"/>
   </Grid>
   <WrapPanel Grid.Row="2" Margin="5,2">
    <CheckBox x:Name="Online" Content="온라인 지도" Margin="0,0,8,0" FontSize="10" VerticalAlignment="Center" Checked="Online_Changed" Unchecked="Online_Changed"
              ToolTip="켜면 지도 제공자에 주변 타일 영역이 전달됩니다. 사진·파일명·DB는 전송하지 않습니다."/>
    <TextBlock HorizontalAlignment="Right" FontSize="10"><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="Attribution_Click">© OpenStreetMap contributors</Hyperlink></TextBlock>
   </WrapPanel>
  </Grid>
 </Border>
</UserControl>
