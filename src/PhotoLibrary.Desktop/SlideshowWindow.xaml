<!-- 사진을 화면에 맞춰 전체 화면으로 표시하고 시간 간격 슬라이드쇼를 제어합니다. -->
<Window x:Class="PhotoLibrary.Desktop.SlideshowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사진 전체 화면" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Black" Foreground="White"
        FontFamily="Malgun Gothic" FontSize="14" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="Photo" Stretch="Uniform" AutomationProperties.Name="전체 화면 사진"/>
    <StackPanel Grid.Row="1" Background="#172238" Margin="0" >
      <TextBlock x:Name="Caption" Margin="14,8,14,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="Hint" Margin="14,8" Text="사진 불러오는 중…" TextWrapping="Wrap"/>
      <WrapPanel Margin="14,0,14,12">
        <Button x:Name="Previous" Content="이전 (←)" Click="Previous_Click"/>
        <Button x:Name="PlayPause" Content="재생 (Space)" Click="PlayPause_Click"/>
        <Button x:Name="Next" Content="다음 (→)" Click="Next_Click"/>
        <TextBlock Text="간격(초)" VerticalAlignment="Center" Margin="8,0"/>
        <TextBox x:Name="IntervalInput" Width="55" VerticalContentAlignment="Center" Margin="0,0,8,0"
                 AutomationProperties.Name="전체 화면 슬라이드쇼 간격 초" ToolTip="1~300초의 정수"/>
        <Button x:Name="ApplyInterval" Content="간격 적용" Click="ApplyInterval_Click"/>
        <Button x:Name="Exit" Content="닫기 (Esc)" Click="Exit_Click"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
