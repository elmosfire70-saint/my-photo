<!-- 폴더와 날짜 목록을 탐색하고 읽기 전용 사진 미리보기를 표시합니다. -->
<Window x:Class="PhotoLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoLibrary.Desktop"
        Title="내 사진함 · 읽기 전용" Width="1280" Height="900" MinWidth="1020" MinHeight="650"
        Background="#F3F6FA" Foreground="#172A46" FontFamily="Malgun Gothic" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CDD6E4"/>
    </Style>
    <Style TargetType="DatePicker"><Setter Property="Width" Value="145"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <TextBlock Text="내 사진함" FontSize="29" FontWeight="Bold"/>
      <TextBlock Text="원본은 그대로 · 내 PC에서 탐색" Margin="20,12,0,0" Foreground="#50627A"/>
      <Border Background="#DDEFEA" CornerRadius="5" Padding="12,7" HorizontalAlignment="Right">
        <TextBlock Text="읽기 전용" Foreground="#18644E" FontWeight="Bold"/>
      </Border>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Button x:Name="ChooseFolder" Content="폴더 선택…" Click="ChooseFolder_Click" Background="#2356A8" Foreground="White"/>
        <Button x:Name="ChooseDatabase" Content="DB 위치…" Click="ChooseDatabase_Click"/>
        <Button x:Name="Rescan" Content="다시 수집" Click="Rescan_Click" IsEnabled="False"/>
        <Button x:Name="CancelScan" Content="수집 취소" Click="CancelScan_Click" IsEnabled="False"/>
        <TextBlock Text="등록은 원본 복사·이동이 아닙니다." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#50627A"/>
      </StackPanel>
      <StackPanel x:Name="Filters" Orientation="Horizontal">
        <Label Content="시작일" Target="{Binding ElementName=FromDate}"/>
        <DatePicker x:Name="FromDate" AutomationProperties.Name="시작일"/>
        <Label Content="종료일" Target="{Binding ElementName=ToDate}"/>
        <DatePicker x:Name="ToDate" AutomationProperties.Name="종료일"/>
        <Button x:Name="ApplyFilter" Content="기간 적용" Click="Apply_Click"/>
        <Button x:Name="ClearFilter" Content="전체 날짜" Click="Clear_Click"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="FolderLabel" Grid.Row="2" Text="사진 폴더를 선택하세요. 자동 검색하거나 원본을 수정하지 않습니다."
               TextTrimming="CharacterEllipsis" Margin="0,0,0,12" Foreground="#50627A"/>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="410" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" Padding="12" BorderBrush="#DEE4ED" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="폴더의 사진" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="PreviousPage" Content="이전" Click="Previous_Click" IsEnabled="False"/>
            <Button x:Name="NextPage" Content="다음" Click="Next_Click" IsEnabled="False"/>
            <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Text="200건씩 표시"/>
          </StackPanel>
          <DataGrid x:Name="PhotoList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                    EnableRowVirtualization="True" RowHeight="56" SelectionChanged="PhotoList_SelectionChanged"
                    Background="White" BorderThickness="0" AutomationProperties.Name="사진 목록">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="파일 · 촬영일" Width="*">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <StackPanel Margin="5,5"><TextBlock Text="{Binding Record.RelativePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="#65758A" Margin="0,4,0,0"/>
                  </StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="상태" Binding="{Binding StateLabel}" Width="86"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" Padding="14" BorderBrush="#DEE4ED" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
          <DockPanel x:Name="ImageTools" Margin="0,0,0,12">
            <TextBlock Text="미리보기" FontSize="18" FontWeight="Bold" Margin="0,0,18,0"/>
            <Button Content="화면 맞춤" Click="Fit_Click" Padding="10,4"/>
            <TextBlock Text="확대" VerticalAlignment="Center" Margin="8,0"/>
            <Slider x:Name="Zoom" Minimum="10" Maximum="800" Value="100" Width="140" ValueChanged="Zoom_ValueChanged"
                    VerticalAlignment="Center" AutomationProperties.Name="미리보기 확대율"/>
            <TextBlock Text="{Binding ElementName=Zoom, Path=Value, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </DockPanel>
          <ScrollViewer x:Name="Viewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Background="#152238" PreviewMouseWheel="Viewer_MouseWheel">
            <Image x:Name="Preview" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                   MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
              <Image.LayoutTransform><ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
            </Image>
          </ScrollViewer>
          <local:VideoPane x:Name="VideoPanel" Grid.Row="1" Visibility="Collapsed"/>
          <TextBlock x:Name="PreviewHint" Grid.Row="2" Text="사진을 선택하세요. 드래그 이동 · Ctrl+휠 확대" Foreground="#65758A" Margin="0,9,0,9" TextWrapping="Wrap"/>
          <TextBox x:Name="Metadata" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="#F5F7FA" BorderThickness="0" Padding="10" AutomationProperties.Name="사진 메타데이터"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="4" Text="준비됨 · 클라우드 업로드 없음" Margin="0,14,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
